# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com,https://your-api-domain.com
SECURE_SSL_REDIRECT=False

# PostgreSQL (used by Docker; omit POSTGRES_HOST for local SQLite)
POSTGRES_DB=credentials
POSTGRES_USER=credentials
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Twilio Emails API (comms.twilio.com)
TWILIO_API_KEY=your-twilio-api-key
TWILIO_CLIENT_SECRET=your-twilio-api-secret
TWILIO_FROM_EMAIL=support@example.com
TWILIO_FROM_NAME=Support Team
# Optional / reserved for other Twilio products
# TWILIO_SID=your-twilio-account-sid

# Pass services
GOOGLE_PASS_SERVICE_URL=http://googlepassservice.railway.internal
APPLE_PASS_SERVICE_URL=http://appleqrpassservice.railway.internal
PASS_SERVICE_TIMEOUT_SECONDS=10

# Wallet button images (hosted assets for email clients)
APPLE_WALLET_BUTTON_PNG_URL=https://res.cloudinary.com/dlc0p1mey/image/upload/v1788378974/AppleButton_uopjju.svg
GOOGLE_WALLET_BUTTON_PNG_URL=https://res.cloudinary.com/dlc0p1mey/image/upload/v1788378976/GoogleButton_vthx5d.svg

# Frontend wallet pages
FRONTEND_BASE_URL=https://your-frontend-domain.com
WALLET_TOKEN_EXPIRY_DAYS=7
